# Backend server
PORT=3000
NODE_ENV=development

# Supabase project credentials.
# Do not commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Backend only. Never expose this key in the Expo app or any client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Local Expo dev server origin. Adjust when using a physical device or deployed frontend.
CORS_ORIGIN=http://localhost:8081

# URL to redirect to after a password reset email link is clicked.
# Falls back to `${CORS_ORIGIN}/update-password` when empty.
PASSWORD_RESET_REDIRECT_URL=

# Base URL used to build video call links for the chat module.
# Defaults to https://meet.jit.si when empty.
VIDEO_CALL_BASE_URL=
